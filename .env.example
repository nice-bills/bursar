# Organization API key from app.keeperhub.com -> avatar menu -> API Keys
KEEPERHUB_API_KEY=kh_xxxxxxxxxxxxxxxxxxxxxxxx
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api

# Chain used for development runs. 11155111 = Sepolia, 84532 = Base Sepolia,
# 8453 = Base mainnet, 1 = Ethereum mainnet (gas sponsored by KeeperHub).
BURSAR_CHAIN_ID=11155111

# Where the smoke test sends its test transfer. Safe default: our own signer,
# so the day-1 proof-of-life moves value without leaving the org wallet.
BURSAR_SMOKE_TO=
