# Organization API key from app.keeperhub.com -> avatar menu -> API Keys
KEEPERHUB_API_KEY=kh_xxxxxxxxxxxxxxxxxxxxxxxx
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api

# Where the plugin reads its config and writes its ledger. Both optional;
# these are the defaults.
BURSAR_CONFIG_PATH=bursar.config.json
BURSAR_LEDGER_PATH=data/ledger.jsonl

# The id of the person allowed to approve or decline a held movement. Without
# it REVIEW_PENDING lists what is waiting but releases nothing — an approval
# gate anyone in the room can satisfy is not a gate.
BURSAR_APPROVER=

# Chain the SMOKE TEST runs against. Every real movement takes its chain from
# bursar.config.json; this only affects `npm run smoke`.
# 11155111 = Sepolia, 84532 = Base Sepolia, 8453 = Base mainnet.
BURSAR_CHAIN_ID=11155111

# Where the smoke test would send its test transfer. Safe default: our own
# signer, so the day-1 proof-of-life moves value without leaving the org
# wallet. `npm run smoke` is read-only unless you pass --execute.
BURSAR_SMOKE_TO=
BURSAR_SMOKE_AMOUNT=
BURSAR_SMOKE_TOKEN=

# Optional. A model provider key, so `npm run agent` can show a real model
# choosing an action rather than falling back to the deterministic stub.
OPENROUTER_API_KEY=

# Optional, and testnet only. The key that signs x402 invoices when
# `npm run lucid -- --settle` pays another agent.
#
# Every other movement in this project is signed by KeeperHub's custodial
# Turnkey signer and never touches a raw key. This one exists because x402
# settlement happens client-side, so something local has to sign. Treat it
# accordingly: fund it with test USDC and a little test ETH, nothing more.
# It is never logged, never returned, and never written to the ledger.
BURSAR_PAYER_PRIVATE_KEY=

# Optional RPC override for the payer. Defaults to viem's public endpoint,
# which rate-limits; set your own for anything beyond a demo.
BURSAR_PAYER_RPC_URL=

# Optional. The MCP endpoint, when it is not derived from KEEPERHUB_BASE_URL.
KEEPERHUB_MCP_URL=

# Optional, all with working defaults. Knobs for the demo scripts:
#   BURSAR_DEMO_REVENUE  revenue figure `npm run demo` splits
#   BURSAR_MODEL         model `npm run agent` asks to choose an action
#   BURSAR_CHARACTER     character file `npm run agent` boots
#   LUCID_AGENT_URL      the agent `npm run lucid` discovers and pays
BURSAR_DEMO_REVENUE=
BURSAR_MODEL=
BURSAR_CHARACTER=
LUCID_AGENT_URL=
