{
  "name": "plugin-bursar",
  "version": "0.1.0",
  "private": true,
  "description": "The autonomous CFO for AI agents. MCP in, KeeperHub out.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chains": "tsx scripts/chains.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "workflow": "tsx scripts/workflow.ts",
    "chaos": "tsx scripts/chaos.ts",
    "agent": "tsx scripts/agent.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@elizaos/plugin-bootstrap": "^1.7.2",
    "@elizaos/plugin-openrouter": "^1.5.17",
    "@elizaos/plugin-sql": "^1.7.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "peerDependencies": {
    "@elizaos/core": "^1.7.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "bursar.config.example.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}