{
  "name": "plugin-bursar",
  "version": "0.1.0",
  "description": "An onchain treasury for ElizaOS agents. Revenue splits, a gas keeper, and surplus into Aave, executed and audited through KeeperHub.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chains": "tsx scripts/chains.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "workflow": "tsx scripts/workflow.ts",
    "listing": "tsx scripts/listing.ts",
    "chaos": "tsx scripts/chaos.ts",
    "agent": "tsx scripts/agent.ts",
    "context-cost": "tsx scripts/context-cost.ts",
    "prepare": "npm run build",
    "aave": "tsx scripts/aave.ts",
    "lucid": "tsx scripts/lucid.ts"
  },
  "dependencies": {
    "@x402/evm": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "viem": "^2.56.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@elizaos/plugin-bootstrap": "^1.7.2",
    "@elizaos/plugin-openrouter": "^1.5.17",
    "@elizaos/plugin-sql": "^1.7.2",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "peerDependencies": {
    "@elizaos/core": "^1.7.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bursar.config.example.json",
    "character"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "npm@11.19.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nice-bills/bursar.git"
  },
  "keywords": [
    "elizaos",
    "elizaos-plugin",
    "keeperhub",
    "agent",
    "treasury",
    "web3"
  ]
}
